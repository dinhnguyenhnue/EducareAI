datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  PARENT
  COMMUNITY_USER
  ADMIN
  COMMUNITY
}

enum AssignmentType {
  INDIVIDUAL
  GROUP
  PROJECT
  PRACTICE
  EXAM
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  RETURNED
  GRADED
}

enum SyncStatus {
  NONE
  PENDING
  SYNCED
  SYNC_ERROR
}

enum CommunityZone {
  CURATED
  STUDENT_SHOWCASE
}

enum PostStatus {
  DRAFT
  PENDING
  APPROVED
  PUBLISHED
  NEEDS_REVISION
  REJECTED
}

model User {
  id               String                @id @default(uuid())
  email            String                @unique
  googleSub        String?               @unique // Stable Google OpenID Connect 'sub' identifier
  googleId         String?
  passwordHash     String?
  fullName         String
  role             String                @default("STUDENT") // SUPER_ADMIN, SCHOOL_ADMIN, TEACHER, STUDENT, PARENT, COMMUNITY_USER
  avatarUrl        String?
  emailVerified    Boolean               @default(false)
  accountStatus    String                @default("ACTIVE") // PENDING_ACTIVATION, ACTIVE, SUSPENDED, LOCKED
  isVerified       Boolean               @default(true)
  isActive         Boolean               @default(true)
  mfaRecommended   Boolean               @default(false)
  lastLoginAt      DateTime?
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  studentProfile   StudentProfile?
  teacherProfile   TeacherProfile?
  parentProfile    ParentProfile?
  userRoles        UserRoleAssignment[]
  sessions         AuthSession[]
  auditLogs        AuditLog[]
  communityPosts   CommunityPost[]
  promptsAuthored  PromptTemplate[]
  syncLogs         SyncLog[]
  googleConnection GoogleConnection?
}

model RoleDefinition {
  id              String                @id @default(uuid())
  code            String                @unique // SUPER_ADMIN, SCHOOL_ADMIN, TEACHER, STUDENT, PARENT, COMMUNITY_USER
  name            String
  description     String
  isSystem        Boolean               @default(true)
  createdAt       DateTime              @default(now())

  rolePermissions RolePermission[]
  userRoles       UserRoleAssignment[]
}

model Permission {
  id              String                @id @default(uuid())
  code            String                @unique // e.g., "users:manage", "assignments:create", "grades:write"
  resource        String
  action          String
  description     String
  createdAt       DateTime              @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String         @id @default(uuid())
  roleId       String
  role         RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRoleAssignment {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy String?
  assignedAt DateTime       @default(now())

  @@unique([userId, roleId])
}

model AuthSession {
  id             String   @id @default(uuid())
  sessionToken   String   @unique
  csrfToken      String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeViewRole String?  // For SUPER_ADMIN Multi-View Switcher: ADMIN, TEACHER, STUDENT, PARENT
  authMethod     String   @default("GOOGLE_OIDC")
  ipAddress      String?
  userAgent      String?
  isRevoked      Boolean  @default(false)
  expiresAt      DateTime
  lastActiveAt   DateTime @default(now())
  createdAt      DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  actorRole  String
  action     String   // e.g., "AUTH_LOGIN_SUCCESS", "ROLE_VIEW_SWITCH", "RBAC_ACCESS_DENIED", "STUDENT_IMPORT"
  resource   String   // e.g., "AUTH", "USER", "ASSIGNMENT", "GRADE", "GOOGLE_WORKSPACE"
  resourceId String?
  status     String   @default("SUCCESS") // SUCCESS, DENIED, FAILED
  ipAddress  String?
  details    String?  // JSON string
  createdAt  DateTime @default(now())
}

model StudentProfile {
  id              String             @id @default(uuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentCode     String             @unique
  gradeLevel      Int                // 6, 7, 8, 9
  dateOfBirth     String?
  gender          String?
  classId         String?
  schoolClass     SchoolClass?       @relation(fields: [classId], references: [id])
  aiConfig        String?            // JSON string for personalized AI instructions
  learningGoals   String?
  createdAt       DateTime           @default(now())

  enrollments     Enrollment[]
  submissions     Submission[]
  grades          Grade[]
  progressRecords LearningProgress[]
  selfAssessments SelfAssessment[]
  peerReviews     PeerReview[]
  learningRecords LearningRecord[]
  parents         ParentStudent[]
}

model TeacherProfile {
  id              String        @id @default(uuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherCode     String        @unique
  specialization  String        // "Tin học", "Toán", "Ngữ văn"...
  createdAt       DateTime      @default(now())

  homeroomClasses SchoolClass[]
  lessonsCreated  Lesson[]
  assignments     Assignment[]
}

model ParentProfile {
  id        String          @id @default(uuid())
  userId    String          @unique
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  createdAt DateTime        @default(now())

  children  ParentStudent[]
}

model ParentStudent {
  id           String         @id @default(uuid())
  parentId     String
  parent       ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  relationship String         @default("PHU_HUYNH")
  isVerified   Boolean        @default(true)

  @@unique([parentId, studentId])
}

model AcademicYear {
  id          String        @id @default(uuid())
  name        String        @unique // "2026-2027"
  startYear   Int
  endYear     Int
  isCurrent   Boolean       @default(true)

  classes     SchoolClass[]
  enrollments Enrollment[]
  grades      Grade[]
}

model SchoolClass {
  id                String           @id @default(uuid())
  name              String           // "6A1", "7A2", "8A1"
  gradeLevel        Int              // 6, 7, 8
  academicYearId    String
  academicYear      AcademicYear     @relation(fields: [academicYearId], references: [id])
  homeroomTeacherId String?
  homeroomTeacher   TeacherProfile?  @relation(fields: [homeroomTeacherId], references: [id])

  students          StudentProfile[]
  enrollments       Enrollment[]
  assignments       Assignment[]

  @@unique([name, academicYearId])
}

model Enrollment {
  id             String         @id @default(uuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String
  schoolClass    SchoolClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  status         String         @default("ACTIVE") // ACTIVE, TRANSFERRED, COMPLETED
  enrolledAt     DateTime       @default(now())

  @@unique([studentId, classId, academicYearId])
}

model Subject {
  id              String             @id @default(uuid())
  name            String             // "Tin học", "Toán", "Ngữ văn"...
  code            String             @unique // "TIN7", "TOAN7", "VAN7"
  gradeLevel      Int                // 6, 7, 8
  topics          Topic[]
  assignments     Assignment[]
  grades          Grade[]
  progressRecords LearningProgress[]
  promptTemplates PromptTemplate[]
  communityPosts  CommunityPost[]
}

model Topic {
  id         String   @id @default(uuid())
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name       String   // "Chủ đề A: Máy tính và cộng đồng"
  orderIndex Int      @default(0)

  lessons    Lesson[]
}

model Lesson {
  id              String           @id @default(uuid())
  topicId         String
  topic           Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  teacherId       String
  teacher         TeacherProfile   @relation(fields: [teacherId], references: [id])
  title           String
  contentBlocks   String           // JSON array of content blocks (text, video, embed, etc.)
  status          String           @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  googleDocId     String?
  driveFileLinks  String?          // JSON array of linked Google Drive files
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  selfAssessments SelfAssessment[]
}

model Assignment {
  id                    String         @id @default(uuid())
  subjectId             String
  subject               Subject        @relation(fields: [subjectId], references: [id])
  teacherId             String
  teacher               TeacherProfile @relation(fields: [teacherId], references: [id])
  classId               String
  schoolClass           SchoolClass    @relation(fields: [classId], references: [id])
  title                 String
  description           String
  instructions          String?
  type                  String         @default("INDIVIDUAL") // INDIVIDUAL, GROUP, PROJECT, PRACTICE, EXAM
  maxScore              Float          @default(10.0)
  rubric                String?        // JSON string defining rubric criteria
  assignedAt            DateTime       @default(now())
  dueAt                 DateTime
  maxSubmissions        Int            @default(3)
  submissionType        String         @default("MIXED") // TEXT, FILE, LINK, MIXED
  status                String         @default("ASSIGNED") // DRAFT, PUBLISHED, ASSIGNED, CLOSED
  classroomCourseworkId String?
  calendarEventId       String?
  driveFolderId         String?
  syncStatus            String         @default("NONE") // NONE, PENDING, SYNCED, SYNC_ERROR
  syncErrorMessage      String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  submissions           Submission[]
  grades                Grade[]
}

model Submission {
  id                   String         @id @default(uuid())
  assignmentId         String
  assignment           Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId            String
  student              StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber        Int            @default(1)
  content              String?        // Text content or reflection
  attachments          String?        // JSON array of attachments (drive links, uploaded files, links)
  status               String         @default("SUBMITTED") // DRAFT, SUBMITTED, LATE, RETURNED, GRADED
  score                Float?
  teacherComment       String?
  aiSuggestion         String?        // AI proposed feedback draft
  aiSuggestionAccepted Boolean        @default(false)
  rubricScores         String?        // JSON breakdown of points per criterion
  gradedBy             String?
  submittedAt          DateTime       @default(now())
  gradedAt             DateTime?

  peerReviews          PeerReview[]
  grades               Grade[]
}

model Grade {
  id             String         @id @default(uuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId      String
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  assignmentId   String?
  assignment     Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  submissionId   String?
  submission     Submission?    @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  score          Float
  maxScore       Float          @default(10.0)
  gradeType      String         @default("PROJECT") // REGULAR, MIDTERM, FINAL, PROJECT
  gradedBy       String?
  feedback       String?
  recordedAt     DateTime       @default(now())
}

model LearningProgress {
  id                   String         @id @default(uuid())
  studentId            String
  student              StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId            String
  subject              Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  masteryPercent       Float          @default(0.0)
  completedLessons     Int            @default(0)
  completedAssignments Int            @default(0)
  strengths            String?
  gaps                 String?
  nextStepSuggestion   String?
  updatedAt            DateTime       @updatedAt

  @@unique([studentId, subjectId])
}

model PeerReview {
  id             String         @id @default(uuid())
  submissionId   String
  submission     Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId     String
  reviewer       StudentProfile @relation(fields: [reviewerId], references: [id])
  criteriaScores String?        // JSON breakdown
  comment        String
  status         String         @default("SUBMITTED") // PENDING, SUBMITTED, MODERATED, HIDDEN
  createdAt      DateTime       @default(now())
}

model SelfAssessment {
  id           String         @id @default(uuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lessonId     String?
  lesson       Lesson?        @relation(fields: [lessonId], references: [id])
  assignmentId String?
  responses    String         // JSON: questions and self scores
  reflection   String?
  createdAt    DateTime       @default(now())
}

model PromptTemplate {
  id            String   @id @default(uuid())
  title         String
  subjectId     String?
  subject       Subject? @relation(fields: [subjectId], references: [id])
  gradeLevel    Int?     // 6, 7, 8
  difficulty    String   @default("BASIC") // BASIC, INTERMEDIATE, ADVANCED
  promptContent String
  usageGuide    String?
  exampleInput  String?
  exampleOutput String?
  aiUsageNotes  String?
  authorId      String
  author        User     @relation(fields: [authorId], references: [id])
  status        String   @default("PUBLISHED") // DRAFT, PENDING, APPROVED, PUBLISHED
  useCount      Int      @default(0)
  createdAt     DateTime @default(now())
}

model CommunityPost {
  id                 String   @id @default(uuid())
  authorId           String
  author             User     @relation(fields: [authorId], references: [id])
  title              String
  description        String
  processDescription String?
  selfEvaluation     String?
  references         String?
  subjectId          String?
  subject            Subject? @relation(fields: [subjectId], references: [id])
  category           String   // "Dự án học sinh", "Sáng tạo AI", "Góc Tin học"...
  attachments        String?  // JSON
  toolsUsed          String?  // JSON
  status             String   @default("PUBLISHED") // DRAFT, PENDING, APPROVED, PUBLISHED, NEEDS_REVISION, REJECTED
  zone               String   @default("STUDENT_SHOWCASE") // CURATED, STUDENT_SHOWCASE
  viewCount          Int      @default(0)
  createdAt          DateTime @default(now())
}

model LearningRecord {
  id               String         @id @default(uuid())
  studentId        String
  student          StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId        String
  activityType     String         // "LESSON_VIEW", "PRACTICE", "ASSIGNMENT", "AI_CHAT"
  score            Float?
  accuracyRate     Float?
  timeSpentSeconds Int            @default(0)
  detailData       String?        // JSON
  recordedAt       DateTime       @default(now())
}

model GoogleConnection {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleEmail      String
  googleSub        String?
  scopesGranted    String    // JSON array
  accessTokenHash  String?
  refreshTokenHash String?
  status           String    @default("CONNECTED") // CONNECTED, EXPIRED, REVOKED
  lastSyncAt       DateTime?
  createdAt        DateTime  @default(now())
}

model SyncLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  service      String   // "DRIVE", "DOCS", "SHEETS", "CLASSROOM", "CALENDAR", "OAUTH"
  action       String   // "CREATE", "SYNC", "UPDATE"
  resourceId   String?
  status       String   // "SUCCESS", "FAILED"
  errorMessage String?
  createdAt    DateTime @default(now())
}

// ============================================================================
// CỔNG HỌC TẬP TIN HỌC – XƯỞNG SÁNG TẠO TRÒ CHƠI (TIN HỌC SÁNG TẠO) ENTITIES
// ============================================================================

model Question {
  id                String           @id @default(uuid())
  code              String           @unique // Stable ID (Never use row number as ID)
  subjectCode       String           @default("TIN7") // TIN7, TOAN7, VAN7, KHTN7... (Multi-subject per SRS Principle #9)
  subjectName       String           @default("Tin học")
  gradeLevel        Int              // 6, 7, 8, 9
  topicName         String           // Chủ đề SGK
  lessonTitle       String           // Tên bài học
  learningObjective String           // Mục tiêu cần đạt (YCCĐ)
  cognitiveLevel    String           @default("UNDERSTAND") // REMEMBER, UNDERSTAND, APPLY, HIGH_APPLY
  sourceBook        String?          // Nguồn SGK/tài liệu (VD: SGK Tin học 7 - Kết nối tri thức)
  sourcePage        String?          // Trang SGK (VD: Trang 12-15)
  questionText      String
  questionType      String           @default("MULTIPLE_CHOICE") // MULTIPLE_CHOICE, TRUE_FALSE, SHORT_ANSWER
  optionsJson       String           // JSON array of choices: [{"id":"A","text":"..."}, ...]
  correctAnswer     String           // Server-only secret answer key ("A", "B", etc.)
  explanation       String           // Server-only solution & pedagogical explanation
  points            Float            @default(1.0)
  version           Int              @default(1) // Incremented when question content is edited
  status            String           @default("APPROVED") // DRAFT, PENDING_REVIEW, APPROVED, ARCHIVED
  isAiDraft         Boolean          @default(false) // True if generated by AI; requires Teacher approval before exam use
  isDemoData        Boolean          @default(false) // Tagged for safe demo purge
  authorId          String
  approvedById      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  assessmentItems   AssessmentItem[]

  @@index([subjectCode, gradeLevel, status])
  @@index([cognitiveLevel])
}

model Assessment {
  id                String           @id @default(uuid())
  code              String           @unique
  subjectCode       String           @default("TIN7") // TIN7, TOAN7, VAN7, KHTN7...
  subjectName       String           @default("Tin học")
  title             String
  description       String
  classId           String
  gradeLevel        Int              @default(7)
  lessonTitle       String?
  mode              String           @default("PRACTICE") // PRACTICE (Luyện tập) | EXAM (Kiểm tra chính thức)
  timeLimitMinutes  Int?             // Null for untimed practice; e.g. 15 or 45 for EXAM
  maxAttempts       Int              @default(1) // 0 = unlimited for PRACTICE; 1 for EXAM
  revealAnswersMode String           @default("IMMEDIATE") // IMMEDIATE (Practice), AFTER_CLOSED (Exam), NEVER
  status            String           @default("PUBLISHED") // DRAFT, PUBLISHED, CLOSED
  googleFormId      String?
  googleFormUrl     String?
  driveFileId       String?          // Linked exam file in 02_HOC_LIEU/<Mon>
  isDemoData        Boolean          @default(false)
  createdById       String
  publishedAt       DateTime?
  dueAt             DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  items             AssessmentItem[]
  attempts          Attempt[]

  @@index([subjectCode, classId, mode, status])
}

model AssessmentItem {
  id                    String     @id @default(uuid())
  assessmentId          String
  assessment            Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionId            String
  question              Question   @relation(fields: [questionId], references: [id])
  questionVersion       Int        // Pinned version at the time assessment was published
  orderIndex            Int        @default(0)
  points                Float      @default(1.0)
  snapshotQuestionText  String     // Immutable snapshot so editing Question Bank never alters past exams
  snapshotOptionsJson   String
  snapshotCorrectAnswer String
  snapshotExplanation   String
  snapshotObjective     String?

  answers               Answer[]

  @@unique([assessmentId, orderIndex])
}

model Attempt {
  id             String     @id @default(uuid())
  assessmentId   String
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId      String     // User.id of the student
  studentEmail   String
  studentName    String
  classId        String
  attemptNumber  Int        @default(1)
  idempotencyKey String     @unique // Prevents duplicate submission on double-click / network retry
  status         String     @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, EXPIRED_AUTO_SUBMITTED
  startedAt      DateTime   @default(now())
  expiresAt      DateTime?  // Enforced strictly on the server
  submittedAt    DateTime?
  totalScore     Float?     // Calculated strictly on the server
  maxScore       Float      @default(10.0)
  isDemoData     Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  answers        Answer[]

  @@index([assessmentId, studentId])
}

model Answer {
  id               String         @id @default(uuid())
  attemptId        String
  attempt          Attempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  assessmentItemId String
  assessmentItem   AssessmentItem @relation(fields: [assessmentItemId], references: [id], onDelete: Cascade)
  studentResponse  String         // Chosen option ID or short answer text
  isCorrect        Boolean?       // Evaluated on server upon submission
  earnedPoints     Float          @default(0.0)
  savedAt          DateTime       @default(now())

  @@unique([attemptId, assessmentItemId])
}

model Project {
  id                  String           @id @default(uuid())
  slug                String           @unique
  subjectCode         String           @default("TIN7") // Multi-subject support (TIN7, TOAN7, VAN7, KHTN7...)
  subjectName         String           @default("Tin học")
  title               String
  authorId            String           // User.id of author
  displayAuthorName   String
  classId             String
  className           String           @default("7A1")
  gradeLevel          Int              @default(7)
  lessonTitle         String
  learningObjective   String
  gameType            String           @default("QUIZ_10") // QUIZ_10 (>=10 questions) | SIMULATION_3_TASKS (>=3 tasks)
  howToPlay           String
  knowledgeSummary    String
  referenceSources    String           // Nguồn SGK / tài liệu tham khảo
  aiToolsUsed         String           // Khai báo công cụ AI (Gem, Gemini...) đã hỗ trợ
  studentContribution String           // Khai báo phần học sinh tự thiết kế, lập trình và kiểm thử
  status              String           @default("DRAFT") // DRAFT, PENDING_REVIEW, NEEDS_REVISION, APPROVED, HIDDEN
  approvedVersionId   String?          // Points to the last APPROVED ProjectVersion (so v2 pending doesn't break public v1)
  currentVersionNum   Int              @default(1)
  driveFolderId       String?          // Folder ID in 04_SAN_PHAM_SANG_TAO/Tro_choi_HTML
  approvedDriveFileId String?          // File ID in 04_SAN_PHAM_SANG_TAO/San_pham_da_duyet
  playCount           Int              @default(0)
  isDemoData          Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  versions            ProjectVersion[]
  comments            Comment[]
  reports             Report[]

  @@index([subjectCode, status, gradeLevel, classId])
}

model ProjectVersion {
  id                String    @id @default(uuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionNumber     Int       @default(1)
  changelog         String?
  htmlSourceCode    String    // Self-contained single-file HTML (HTML + CSS + JS)
  fileSizeBytes     Int       @default(0)
  driveFileId       String?   // Backed up HTML version fileId in Google Drive
  staticScanJson    String    // JSON report of static analysis (external scripts, network calls, storage, etc.)
  status            String    @default("PENDING_REVIEW") // DRAFT, PENDING_REVIEW, NEEDS_REVISION, APPROVED, REJECTED
  teacherFeedback   String?
  reviewedById      String?
  reviewedByName    String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@unique([projectId, versionNumber])
}

model Comment {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  authorRole String
  content    String   // Rendered strictly as safe plain text (never innerHTML)
  status     String   @default("VISIBLE") // VISIBLE, HIDDEN
  isDemoData Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([projectId, status])
}

model Report {
  id           String    @id @default(uuid())
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commentId    String?
  reporterId   String
  reporterName String
  reason       String    // "LOI_KIEN_THUC", "LOI_KY_THUAT", "NOI_DUNG_KHONG_PHU_HOP", "VI_PHAM_BAN_QUYEN"
  details      String
  status       String    @default("OPEN") // OPEN, RESOLVED, DISMISSED
  resolvedById String?
  resolution   String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  @@index([status])
}

model ModerationLog {
  id            String   @id @default(uuid())
  moderatorId   String
  moderatorName String
  moderatorRole String
  targetType    String   // "PROJECT", "PROJECT_VERSION", "QUESTION", "COMMENT", "REPORT", "DEMO_DATA"
  targetId      String
  action        String   // "APPROVE", "REQUEST_REVISION", "HIDE", "RESTORE_VERSION", "RESOLVE_REPORT", "PURGE_DEMO_DATA"
  reason        String?
  metadataJson  String?
  createdAt     DateTime @default(now())

  @@index([targetType, targetId])
}

// ============================================================================
// KIẾN TRÚC 3 TẦNG: SUPABASE (PRIMARY DB) + GOOGLE SHEETS (TRACKING) + DRIVE (STORAGE/BACKUP)
// ============================================================================

model DriveFolderNode {
  id              String   @id @default(uuid())
  folderCode      String   @unique // e.g., "01_QUAN_TRI", "02_HOC_LIEU_TOAN", "06_BACKUP_DB_ENCRYPTED"
  name            String   // e.g., "01_QUAN_TRI", "Toan", "Database_Encrypted"
  parentCode      String?  // Parent folderCode in EDUCARE_AI/ hierarchy
  folderPath      String   // e.g., "EDUCARE_AI/02_HOC_LIEU/Toan"
  googleFolderId  String   // Persistent Google Drive folderId (lookup never relies on folder path)
  permissionScope String   @default("RESTRICTED_ADMIN_TEACHER") // RESTRICTED_ADMIN_ONLY, RESTRICTED_ADMIN_TEACHER, SCOPED_CLASS_STUDENTS
  accountMode     String   @default("PERSONAL_GMAIL_HYBRID") // WORKSPACE_DOMAIN | PERSONAL_GMAIL_HYBRID
  classId         String?
  subjectCode     String?
  fileCount       Int      @default(0)
  lastVerifiedAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([parentCode])
}

model ClassTrackingSheet {
  id                     String   @id @default(uuid())
  classId                String   @default("CLASS_7A1")
  academicYearId         String   @default("2026-2027")
  purpose                String   @default("CLASS_TRACKING") // CLASS_TRACKING, EXAM_EXPORT, SEMESTER_SUMMARY
  className              String   // e.g., "7A1" -> Spreadsheet "EDUCARE_AI_Tracking_7A1"
  spreadsheetTitle       String   // "EDUCARE_AI_Tracking_7A1"
  spreadsheetId          String?  // Persistent Google Sheets spreadsheetId (Null when DISCONNECTED/DEMO)
  spreadsheetUrl         String?
  driveFolderId          String?  // Stored inside 05_TRACKING_REPORTS/Tracking_theo_lop/
  tabsJson               String   // JSON metadata for 6 tabs: Tổng quan, Danh sách HS, Tiến độ học tập, Điểm & Rubric, Sản phẩm sáng tạo, Báo cáo AI
  pendingNotesImportJson String?  // Teacher notes/comments staged from Sheets awaiting explicit teacher confirmation
  syncCadenceMinutes     Int      @default(10) // 5-15 min incremental sync
  syncStatus             String   @default("DISCONNECTED") // DISCONNECTED, DEMO, PENDING, SYNCED, ERROR
  totalRowsSynced        Int      @default(0)
  lastSyncedAt           DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  importSources          SheetImportSource[]

  @@unique([classId, academicYearId, purpose])
  @@index([className, academicYearId])
}

model AIUsageLog {
  id               String   @id @default(uuid())
  userId           String
  userEmail        String
  userRole         String
  classId          String?
  academicYearId   String?
  className        String?
  subjectCode      String   @default("TIN7")
  featureModule    String   // "AI_TUTOR", "AI_ASSESSMENT_ANALYZER", "AI_TEACHER_ASSISTANT", "AI_PARENT_COMPANION", "PROMPT_LAB"
  modelName        String   @default("gemini-2.5-flash")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCostUsd Float    @default(0.0)
  latencyMs        Int      @default(0)
  status           String   @default("SUCCESS")
  summaryNote      String?
  createdAt        DateTime @default(now())

  @@index([userId, featureModule])
  @@index([className, createdAt])
  @@index([classId, academicYearId, createdAt])
}

model SystemBackupRecord {
  id                  String    @id @default(uuid())
  backupCode          String    @unique // e.g., "BK-EDUCARE-20261108-01"
  backupType          String    @default("DAILY_ENCRYPTED_SNAPSHOT") // DAILY_ENCRYPTED_SNAPSHOT, MANUAL_PRE_MIGRATION, WEEKLY_FULL
  storageTarget       String    @default("SUPABASE_INDEPENDENT_AND_DRIVE_06_BACKUP")
  driveFileId         String?   // Stored in EDUCARE_AI/06_BACKUP/Database_Encrypted/
  driveFolderPath     String    @default("EDUCARE_AI/06_BACKUP/Database_Encrypted")
  encryptionAlgorithm String    @default("AES-256-GCM")
  sha256Checksum      String    // Cryptographic hash to verify backup integrity weekly
  sizeBytes           Int       @default(0)
  tableRowCountsJson  String    // Snapshot of row counts per table for restore verification
  integrityStatus     String    @default("VERIFIED_OK") // VERIFIED_OK, PENDING_CHECK, CORRUPTED
  restoreDrillStatus  String    @default("READY") // READY, DRILL_PASSED, DRILL_FAILED
  lastRestoreDrillAt  DateTime?
  createdById         String
  createdByEmail      String
  createdAt           DateTime  @default(now())
}

// ============================================================================
// KHO HỌC LIỆU & TỆP DÙNG CHUNG (ASSET REPOSITORY - MASTER PROMPT SECTION 4)
// ============================================================================

model Asset {
  id                 String    @id @default(uuid())
  storageKey         String    @unique // Random server-side object key
  originalFilename   String
  mimeType           String
  extension          String
  sizeBytes          Int
  sha256Checksum     String
  category           String    // DOCUMENT, SPREADSHEET, PRESENTATION, IMAGE, AUDIO, VIDEO, HTML, ARCHIVE
  previewMode        String    @default("DOWNLOAD_ONLY") // INLINE_PREVIEW, DOWNLOAD_ONLY, SANDBOX_HTML
  quarantineStatus   String    @default("QUARANTINED") // QUARANTINED, CLEAN_PUBLISHED, REJECTED
  scanNotes          String?
  version            Int       @default(1)
  parentAssetId      String?
  ownerId            String
  ownerRole          String
  classId            String?
  academicYearId     String?
  lessonId           String?
  assignmentId       String?
  submissionId       String?
  driveLinkOptional  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([ownerId, quarantineStatus])
  @@index([classId, quarantineStatus])
  @@index([lessonId])
  @@index([assignmentId])
}

// ============================================================================
// CHỖ CHỜ GEMS & AGENTS (INTEGRATION SLOTS - MASTER PROMPT SECTION 6)
// ============================================================================

model IntegrationSlot {
  id                String    @id @default(uuid())
  code              String    @unique // e.g., "SLOT_LESSON_HINT", "SLOT_GAME_CREATOR", "GEM_TIN7"
  name              String
  kind              String    @default("GEM_LINK") // GEM_LINK | AGENT_API
  contextKey        String    // LESSON_HINT, ASSIGNMENT_EXPLAIN, GAME_CREATOR, TEACHER_ASSISTANT, ANALYTICS_INSIGHT, SUBJECT_GEM
  subjectCode       String?
  gradeLevel        Int?
  provider          String    @default("GOOGLE_GEMINI")
  externalUrl       String?   // Specific Gem URL (never generic homepage)
  endpointRef       String?   // Internal server-side agent endpoint ref
  configJson        String    @default("{}")
  secretRef         String?   // Env variable name only (never raw secret)
  allowedRoles      String    @default("TEACHER,STUDENT")
  classScope        String?   // Null = all allowed classes, or comma-separated classIds
  status            String    @default("DISCONNECTED") // DISCONNECTED, CONFIGURED, HEALTHY, ERROR, DISABLED
  fallbackPrompt    String
  version           Int       @default(1)
  lastCheckedAt     DateTime?
  lastErrorMessage  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([contextKey, status])
}

// ============================================================================
// PIPELINE NHẬP GOOGLE SHEETS & ĐÁNH GIÁ MINH BẠCH (LMS_DATA_DESIGN.md)
// ============================================================================

model SheetImportSource {
  id              String              @id @default(uuid())
  trackingSheetId String?
  trackingSheet   ClassTrackingSheet? @relation(fields: [trackingSheetId], references: [id], onDelete: SetNull)
  spreadsheetId   String
  sheetId         Int                 // Stable numeric sheet tab ID
  classId         String
  academicYearId  String
  direction       String              @default("IMPORT_READ_ONLY") // IMPORT_READ_ONLY, EXPORT_REPORT_ONLY
  mappingJson     String              // Column mapping schema
  mappingVersion  Int                 @default(1)
  timezone        String              @default("Asia/Ho_Chi_Minh")
  enabled         Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  studentIdentities    StudentExternalIdentity[]
  assessmentIdentities AssessmentExternalIdentity[]
  importRuns           SheetImportRun[]
  importedAttempts     ImportedAttempt[]
  importedSummaries    ImportedAssessmentSummary[]

  @@unique([spreadsheetId, sheetId])
  @@index([classId, academicYearId])
}

model StudentExternalIdentity {
  id                String            @id @default(uuid())
  sourceId          String
  source            SheetImportSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalStudentId String            // Student code in external sheet
  studentProfileId  String
  createdAt         DateTime          @default(now())

  @@unique([sourceId, externalStudentId])
  @@index([studentProfileId])
}

model AssessmentExternalIdentity {
  id                   String            @id @default(uuid())
  sourceId             String
  source               SheetImportSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalAssessmentId String
  assessmentId         String
  assessmentVersion    Int               @default(1)
  createdAt            DateTime          @default(now())

  @@unique([sourceId, externalAssessmentId, assessmentVersion])
}

model SheetImportRun {
  id             String            @id @default(uuid())
  sourceId       String
  source         SheetImportSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  idempotencyKey String
  startedAt      DateTime          @default(now())
  completedAt    DateTime?
  status         String            @default("RUNNING") // RUNNING, COMPLETED, FAILED, PARTIAL
  readCount      Int               @default(0)
  acceptedCount  Int               @default(0)
  rejectedCount  Int               @default(0)
  unchangedCount Int               @default(0)
  errorCode      String?

  rows           SheetImportRow[]

  @@unique([sourceId, idempotencyKey])
}

model SheetImportRow {
  id                 String         @id @default(uuid())
  runId              String
  run                SheetImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceRecordId     String         // Stable record_id (Never row number!)
  sourceRevision     Int            @default(1)
  payloadHash        String
  rawJson            String
  status             String         @default("STAGED") // STAGED, ACCEPTED, REJECTED, CONFLICT, UNCHANGED
  errorCodes         String?        // JSON array of validation error codes
  mappedStudentId    String?        // User.id resolved via StudentProfile.userId
  mappedAssessmentId String?
  sourceUpdatedAt    DateTime?
  createdAt          DateTime       @default(now())

  @@index([runId, status])
  @@index([sourceRecordId])
}

model ImportedAttempt {
  id                String              @id @default(uuid())
  sourceId          String
  source            SheetImportSource   @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceRecordId    String
  studentUserId     String              // Maps to User.id (via StudentProfile.userId)
  assessmentId      String
  assessmentVersion Int                 @default(1)
  classId           String
  academicYearId    String
  mode              String              @default("PRACTICE") // PRACTICE | EXAM
  submittedAt       DateTime
  rawScore          Float
  maxScore          Float
  normalizedScore   Float               // 10 * rawScore / maxScore (scale 10)
  normalizedScore100 Float              @default(0.0) // 100 * rawScore / maxScore (scale 100)
  status            String              @default("ACCEPTED") // ACCEPTED, PENDING_CORRECTION_APPROVAL, REVOKED_PROPOSED
  revision          Int                 @default(1)
  importRowId       String
  nativeAttemptId   String?             // Prevents double-counting LMS attempts exported to Sheets & re-imported
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  corrections       AttemptCorrection[]

  @@unique([sourceId, sourceRecordId])
  @@index([studentUserId, assessmentId, submittedAt])
  @@index([classId, academicYearId, submittedAt])
  @@index([sourceId, status])
}

model AttemptCorrection {
  id                String          @id @default(uuid())
  importedAttemptId String
  importedAttempt   ImportedAttempt @relation(fields: [importedAttemptId], references: [id], onDelete: Cascade)
  oldPayload        String
  newPayload        String
  reason            String
  actorId           String
  approvedAt        DateTime?
  sourceRevision    Int
  createdAt         DateTime        @default(now())
}

model ImportedAssessmentSummary {
  id                    String            @id @default(uuid())
  sourceId              String
  source                SheetImportSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  sourceRecordId        String
  studentUserId         String            // User.id
  assessmentId          String
  reportedAttemptCount  Int
  reportedScore         Float
  maxScore              Float             @default(10.0)
  scoreMeaning          String            @default("AGGREGATE_ONLY") // AGGREGATE_ONLY (no fabricated first/latest/trend)
  asOf                  DateTime
  createdAt             DateTime          @default(now())

  @@unique([sourceId, sourceRecordId])
  @@index([studentUserId, assessmentId])
}

model StudentAssessmentMetric {
  id                String   @id @default(uuid())
  studentUserId     String   // User.id
  assessmentId      String
  assessmentVersion Int      @default(1)
  mode              String   @default("PRACTICE") // PRACTICE | EXAM
  windowStart       DateTime
  windowEnd         DateTime
  validAttemptCount Int      @default(0)
  firstScore        Float?   // Null when insufficient data or aggregate-only
  latestScore       Float?
  bestScore         Float?
  meanScore         Float?
  improvement       Float?   // latestScore - firstScore ONLY when validAttemptCount >= 2
  evidenceCount     Int      @default(0)
  computedAt        DateTime @default(now())
  algorithmVersion  String   @default("v1.0-transparent")
  sourceWatermark   String?

  @@unique([studentUserId, assessmentId, assessmentVersion, mode, windowStart, windowEnd])
  @@index([studentUserId, mode])
}

model StudentInsight {
  id               String    @id @default(uuid())
  studentUserId    String    // User.id
  classId          String
  metricSnapshotId String?
  evidenceRefsJson String    // JSON array of real attempt/submission IDs
  suggestedAction  String
  draftText        String
  status           String    @default("DRAFT") // DRAFT, APPROVED, REJECTED
  reviewerId       String?
  reviewedAt       DateTime?
  modelVersion     String?
  promptVersion    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([studentUserId, status])
  @@index([classId, status])
}
